# ---------------------------------------------------------------------------
# Gagnant Promoters — FRONTEND environment variables
# Copy this file to ".env" in this same folder before running/building.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL the React app calls for the API.
# - Local dev with the Vite proxy: leave as /api (requests are proxied to the backend)
# - Separate-domain deployment (e.g. frontend on Vercel, backend on Render):
#     set this to your backend's full URL, e.g. https://api.gagnantpromoters.com/api
VITE_API_URL=/api

# Only used by `npm run dev` locally, to tell the Vite dev server where the
# backend is running so it can proxy /api and /uploads requests to it.
VITE_DEV_PROXY_TARGET=http://localhost:8787

# Optional: change the local Vite dev server port
VITE_PORT=5173
