# ---------------------------------------------------------------------------
# Gagnant Promoters — BACKEND environment variables
# Copy this file to ".env" in this same folder and fill in real values
# before deploying. Never commit the real ".env" file.
# ---------------------------------------------------------------------------

# Server
PORT=8787
NODE_ENV=development

# Public base URL of the API/site (used in sitemap.xml). In production this
# should be your real domain, e.g. https://gagnantpromoters.com
APP_URL=http://localhost:8787

# Security — REQUIRED. Generate a strong random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-in-production

# Comma-separated list of origins allowed to call this API.
# Use * only for local development.
CORS_ORIGIN=*

# --- Optional: outgoing lead-notification emails (SMTP) --------------------
# Leave these blank to disable email notifications — the contact form and
# lead pipeline work fine without them, leads are simply stored in the DB.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER is your
# Gmail address, SMTP_PASS is a 16-character Gmail "App Password" (not your
# normal Gmail password — generate one at https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Fallback recipient if a tenant has no contact email configured yet.
LEAD_NOTIFY_TO=

# --- Required: MongoDB Atlas -------------------------------------------------
# The platform stores all data (tenants, pages, services, projects, blogs,
# leads, media metadata, etc.) in MongoDB. Create a free cluster at
# https://www.mongodb.com/cloud/atlas, add a database user, allow your IP
# (or 0.0.0.0/0 for quick testing), and paste the connection string below —
# include a database name in the path, e.g. ".../gagnant_promoters?...".
# The server will not start without a working MONGO_URI. On first connect,
# empty collections are seeded with starter demo content automatically.
MONGO_URI=
